#version 430 core

layout(local_size_x = 256) in;

struct Particle {
    vec4 positionType;
    vec4 velocity;
};

layout(std430, binding = 0) buffer Particles {
    Particle particles[];
};

layout(std430, binding = 1) buffer CellCounts {
    uint cellCounts[];
};

layout(std430, binding = 2) buffer CellBuckets {
    uint cellBuckets[];
};

uniform uint uParticleCount;
uniform uint uGridResolution;
uniform uint uCellCapacity;
uniform float uWorldRadius;
uniform float uInvWorldSize;

uint cellIndex(ivec3 c) {
    uint r = uGridResolution;
    return uint(c.x) + uint(c.y) * r + uint(c.z) * r * r;
}

ivec3 positionToCell(vec3 p) {
    vec3 normalized = clamp((p + vec3(uWorldRadius)) * uInvWorldSize, vec3(0.0), vec3(0.999999));
    return ivec3(normalized * float(uGridResolution));
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uParticleCount) {
        return;
    }

    ivec3 cell = positionToCell(particles[id].positionType.xyz);
    uint cellId = cellIndex(cell);
    uint slot = atomicAdd(cellCounts[cellId], 1u);
    if (slot < uCellCapacity) {
        cellBuckets[cellId * uCellCapacity + slot] = id;
    }
}
